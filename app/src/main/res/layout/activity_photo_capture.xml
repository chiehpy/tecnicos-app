<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- GRUPO CAPTURA: preview + controles -->
    <FrameLayout
        android:id="@+id/captureGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextureView
            android:id="@+id/texturePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Barra inferior de controles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/btnFlash"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Flash: OFF"
                android:textSize="11sp"
                android:backgroundTint="#55FFFFFF"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnShutter"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="20dp"
                android:backgroundTint="#FFFFFF"
                android:elevation="4dp" />

            <Button
                android:id="@+id/btnSwitchCamera"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Girar cam."
                android:textSize="11sp"
                android:backgroundTint="#55FFFFFF"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </FrameLayout>

    <!-- GRUPO REVISIÓN: foto capturada + confirmar/retomar -->
    <FrameLayout
        android:id="@+id/reviewGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivCapture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Foto capturada" />

        <ProgressBar
            android:id="@+id/pbUploading"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUploadStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="160dp"
            android:gravity="center"
            android:padding="8dp"
            android:background="#AA000000"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC000000"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/btnRetake"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Volver a tomar"
                android:backgroundTint="#757575"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Confirmar y subir"
                android:backgroundTint="#388E3C"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
